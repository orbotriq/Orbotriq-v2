# Firebase client config (Firebase Console > Project settings > Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vaanio-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vaanio-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK: prefer Application Default Credentials on Google hosting.
# For local development, use a dedicated service account outside source control.
FIREBASE_PROJECT_ID=vaanio-app
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Payment providers: add secrets in Secret Manager / Functions secrets, never NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
